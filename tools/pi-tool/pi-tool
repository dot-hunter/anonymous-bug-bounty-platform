#!/usr/bin/env bash
# Direct program-intelligence tool caller — bypasses the LLM layer.
# Use when the model API is flaky or for scripting.
#
# Usage:
#   PI_ARGS='{"connector":"all","max_results":20}' pi-tool discover_programs
#   PI_ARGS='{"handle":"<handle>","target":"blog.acme.com"}' pi-tool resolve_authorization
#   PI_ARGS='{"url":"https://wordpress.org","authorized":true}' pi-tool fingerprint_asset
#   PI_ARGS='{"handle":"<handle>"}' pi-tool rank_wordpress_targets
#   pi-tool <any-tool-name>   (lists all tools if name unknown)
set -euo pipefail
TOOL="${1:?usage: pi-tool <tool>  (set PI_ARGS env for JSON args)}"
export PI_TOOL="$TOOL"
cd /home/bb/.opencode/mcp/servers/program-intelligence-mcp
/home/bb/.opencode/.venv/bin/python << 'PY'
import asyncio, json, os, sys
import server
tool = os.environ["PI_TOOL"]
args = json.loads(os.environ.get("PI_ARGS", "{}"))
async def main():
    tools = {t.name: t for t in await server.server.list_tools()}
    if tool not in tools:
        print(f"Unknown tool: {tool}")
        print("Available:", ", ".join(sorted(tools)))
        return
    for fn in dir(server):
        obj = getattr(server, fn)
        if callable(obj) and getattr(obj, "__name__", None) == tool:
            result = obj(**args)
            print(json.dumps(result, indent=2, default=str))
            return
    print("Handler not found for", tool)
asyncio.run(main())
PY
