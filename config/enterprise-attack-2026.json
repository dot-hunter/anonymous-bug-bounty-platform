{
  "version": "2026.1",
  "description": "Enterprise identity and infrastructure attack matrices for 2026 bug bounty hunting",
  "identity_attack_matrices": {
    "enterprise_sso": {
      "description": "Attack enterprise SSO implementations (SAML, OIDC, OAuth 2.0)",
      "techniques": [
        "SAML signature stripping",
        "SAML assertion injection",
        "OIDC redirect URI manipulation",
        "OAuth authorization code interception",
        "PKCE bypass",
        "Token replay attacks",
        "MFA bypass via SMS interception",
        "MFA bypass via social engineering",
        "Session fixation",
        "JWT algorithm confusion (none/HS256)",
        "JWT key confusion (secret/asymmetric)",
        "JWT issuer spoofing",
        "JWT audience confusion"
      ],
      "tools": ["saml-tool", "oidc-debug", "oauth-toolkit", "jwt_tool"]
    },
    "active_directory": {
      "description": "Attack Active Directory and LDAP environments",
      "techniques": [
        "Kerberoasting",
        "Pass-the-ticket",
        "Pass-the-hash",
        "Silver ticket",
        "Golden ticket",
        "DCSync",
        "LDAP injection",
        "NTLM relay",
        "BloodHound attack paths",
        "ACL abuse",
        "Group policy manipulation"
      ],
      "tools": ["bloodhound", "ldapdomaindump", "impacket", "netexec"]
    },
    "cloud_identity": {
      "description": "Attack cloud identity providers (AWS IAM, Azure AD, GCP IAM)",
      "techniques": [
        "IAM role escalation",
        "Instance metadata extraction",
        "Over-privileged service accounts",
        "Cross-account role assumption",
        "Temporary credential theft",
        "OAuth token theft",
        "API key exposure",
        "Secrets manager access"
